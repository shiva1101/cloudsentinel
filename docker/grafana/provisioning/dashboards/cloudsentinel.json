{
  "title": "CloudSentinel – Observability Dashboard",
  "uid": "cloudsentinel-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "tags": ["cloudsentinel", "devops"],
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service Uptime",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{
        "expr": "up{job='cloudsentinel-app'}",
        "legendFormat": "Status"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "mappings": [
          { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
        ]
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request Rate (req/s)",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{
        "expr": "sum(rate(http_requests_total{job='cloudsentinel-app'}[5m]))",
        "legendFormat": "req/s"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{
        "expr": "sum(rate(http_requests_total{job='cloudsentinel-app',status_code=~'5..'}[5m])) / sum(rate(http_requests_total{job='cloudsentinel-app'}[5m])) * 100",
        "legendFormat": "Error %"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 Latency (ms)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job='cloudsentinel-app'}[5m])) by (le)) * 1000",
        "legendFormat": "p95"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 200 },
            { "color": "red", "value": 500 }
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Request Rate by Status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by(status_code)(rate(http_requests_total{job='cloudsentinel-app'}[5m]))",
          "legendFormat": "HTTP {{ status_code }}"
        }
      ],
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request Latency Percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job='cloudsentinel-app'}[5m])) by (le)) * 1000", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job='cloudsentinel-app'}[5m])) by (le)) * 1000", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job='cloudsentinel-app'}[5m])) by (le)) * 1000", "legendFormat": "p99" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU Usage (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{
        "expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode='idle'}[5m])) * 100)",
        "legendFormat": "{{ instance }}"
      }],
      "options": {
        "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 80 }] }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory Usage (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{
        "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
        "legendFormat": "{{ instance }}"
      }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Active Connections",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "targets": [{
        "expr": "active_connections{job='cloudsentinel-app'}",
        "legendFormat": "Active Connections"
      }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Container CPU Usage",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "targets": [{
        "expr": "sum by(name)(rate(container_cpu_usage_seconds_total{name!=''}[5m])) * 100",
        "legendFormat": "{{ name }}"
      }]
    }
  ]
}
